# Copy this file to .env and fill in ONE key. No key? Use --demo.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=            # needs: pip install google-genai
# OLLAMA_BASE_URL=http://localhost:11434/v1   # local models, for example OLLAMA_MODEL=llama3.1

# auto = use whichever key is set. Or write: anthropic / openai / gemini / ollama
LLM_PROVIDER=auto
# Leave empty for the provider default (claude-sonnet-5-5, gpt-4o-mini, gemini-2.0-flash)
LLM_MODEL=

# Agent limits
MAX_STEPS=6                 # tool calls per investigation
MAX_FIX_ATTEMPTS=2          # fixes tried before escalating

# Safety rules (incidentpilot/policy.py)
ALLOWED_SERVICES=checkout,payments,inventory,search,orders,notifications
MAX_REPLICAS=10
CHANGE_FREEZE=false

# Retrieval
USE_DENSE_RETRIEVAL=true    # false = BM25 only (no model download)
USE_RERANKER=true
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
QDRANT_URL=                 # empty = in-memory Qdrant
QDRANT_API_KEY=
LEARN_FROM_INCIDENTS=true   # save a postmortem after every resolved incident

# Optional Langfuse tracing (pip install langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Server
HOST=127.0.0.1
PORT=8000
